{
  "name": "barwaqt-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/*.integration.js",
    "check": "node scripts/check.js",
    "format": "prettier --write \"src/**/*.js\" \"prisma/*.js\" \"tests/*.js\" \"scripts/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"prisma/*.js\" \"tests/*.js\" \"scripts/*.js\"",
    "db:seed:catalog": "node prisma/seed-catalog.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.0",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "smtp-server": "^3.19.21",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
